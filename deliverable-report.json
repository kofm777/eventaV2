  "deployment": {
    "method": "Docker Compose",
    "services": [
      "mysql (port 3306)",
      "backend (port 8000)",
      "frontend (port 4200)",
      "mailhog (ports 1025, 8025)"
    ],
    "commands": {
      "start": "make up",
      "stop": "make down",
      "seed": "make seed",
      "test": "make test",
      "logs": "make logs"
    }
  },
