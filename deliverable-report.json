  "installation_instructions": {
    "prerequisites": [
      "Docker Desktop installed",
      "Git installed",
      "Ports 3306, 4200, 8000, 8025 available"
    ],
    "steps": [
      "1. Clone the repository",
      "2. Run setup-backend-dirs.ps1 (Windows) or equivalent",
      "3. Run setup-frontend-dirs.ps1 (Windows) or equivalent",
      "4. Copy backend/.env.example to backend/.env",
      "5. Run 'make up' to start all services",
      "6. Run 'make install' to install dependencies",
      "7. Run 'make migrate' to create database tables",
      "8. Run 'make seed' to create admin user",
      "9. Access frontend at http://localhost:4200",
      "10. Access backend at http://localhost:8000",
      "11. Access MailHog at http://localhost:8025"
